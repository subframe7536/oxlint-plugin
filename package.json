{
  "name": "@subf/oxlint-plugin",
  "version": "0.2.1",
  "description": "Custom oxlint plugin for TypeScript and SolidJS",
  "homepage": "https://github.com/subframe7536/oxlint-plugin#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/oxlint-plugin/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/oxlint-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "release": "bumpp --all",
    "qa": "oxlint --fix && oxfmt",
    "prepublishOnly": "bun run build",
    "test": "node --test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.58.0",
    "bumpp": "^11.0.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
