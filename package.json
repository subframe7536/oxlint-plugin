{
  "name": "@subf/oxlint-plugin",
  "version": "0.4.0",
  "description": "Custom oxlint plugin for TypeScript and SolidJS",
  "homepage": "https://github.com/subframe7536/oxlint-plugin#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/oxlint-plugin/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/oxlint-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./config": "./dist/config.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "release": "pnpm i && pnpm run test && pnpm run qa && bumpp --all",
    "qa": "oxlint --fix && oxfmt && tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "parse5": "^7.3.0",
    "validate-html-nesting": "^1.2.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.77.0",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
